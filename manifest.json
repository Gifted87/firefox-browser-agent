{
  "manifest_version": 3,
  "name": "Aetheria - Firefox ReAct Browser Agent",
  "version": "1.0.0",
  "description": "Autonomous ReAct browser agent for Firefox. Automates web tasks, job applications, DOM extraction, and portfolio context ingestion with interactive human-in-the-loop assistance.",
  "browser_specific_settings": {
    "gecko": {
      "id": "aetheria-browser-agent@antigravity.internal",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "unlimitedStorage",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "src/background/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/content_script.js"
      ],
      "css": [
        "src/content/overlay.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "sidebar_action": {
    "default_title": "Aetheria Agent Console",
    "default_panel": "src/sidebar/sidebar.html",
    "default_icon": "icons/icon-48.png"
  },
  "action": {
    "default_title": "Open Aetheria Agent",
    "default_popup": "src/sidebar/sidebar.html",
    "default_icon": "icons/icon-48.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/overlay.css",
        "src/utils/pdfjs/pdf.min.js",
        "src/utils/pdfjs/pdf.worker.min.js",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
